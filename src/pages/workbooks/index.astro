---
import Layout from '../../layouts/Base.astro';
import WorkbookList from '../../components/WorkbookList.astro';
import gumroad from '../../data/gumroad.json';
---
<Layout
  title="Homeschool Workbooks — Greg Maxfield"
  description="The Operation Granny Files Homeschool Workbooks: three hands-on family history workbooks for homeschool families."
>
<section class="page-header">
  <div class="container content-narrow" style="text-align:center;">
    <h1>Operation Granny Files Homeschool Workbooks</h1>
    <p>Three hands-on family history workbooks for homeschool families, adapted from the Operation Granny Files missions. Each one turns real genealogy skills into activities a parent and child can do together.</p>
  </div>
</section>
<section class="container" style="padding-bottom:3rem;">
  <WorkbookList />
  <p style="text-align:center; margin-top:2rem;">
    All three as printable PDFs: ${gumroad.bundle.price} for the set, ${gumroad.price_each} each.<br />
    <a href={gumroad.bundle.url} class="btn btn-primary" target="_blank" rel="noopener" style="margin-top:0.75rem;">Get the Complete Set on Gumroad</a>
  </p>
  <p style="text-align:center; margin-top:2rem;">
    Free sample units, companion pages, and teaching guides live at
    <a href="https://operationgrannyfiles.com/homeschool" target="_blank" rel="noopener">operationgrannyfiles.com</a>.
  </p>
</section>
</Layout>
